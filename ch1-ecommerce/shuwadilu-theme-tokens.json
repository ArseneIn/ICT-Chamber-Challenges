{
  "$schema": "https://developer.mozilla.org/en-US/docs/Web/CSS",
  "name": "Shuwadilu Design System Tokens",
  "version": "2.0.0",
  "brand": {
    "platform": "Shuwadilu E-Commerce Platform",
    "partner": "ICT Chamber Challenge 1"
  },
  "colors": {
    "palette": {
      "lightMint": {
        "name": "Light Mint (Canvas)",
        "hex": "#f4fbf6",
        "rgb": [244, 251, 246],
        "hsl": [137, 47, 97],
        "usage": "App background canvas and base page background"
      },
      "evergreen": {
        "name": "Evergreen",
        "hex": "#0d2818",
        "rgb": [13, 40, 24],
        "hsl": [144, 51, 10],
        "usage": "Dark headings, primary dark surfaces, dark footer background"
      },
      "blackForest": {
        "name": "Black Forest",
        "hex": "#04471c",
        "rgb": [4, 71, 28],
        "hsl": [141, 89, 15],
        "usage": "Hover states, sub-headings, dark accent buttons"
      },
      "seaGreen": {
        "name": "Sea Green (Brand Primary)",
        "hex": "#058c42",
        "rgb": [5, 140, 66],
        "hsl": [147, 93, 28],
        "usage": "Primary CTA buttons, active prices, brand logos, active tabs"
      },
      "malachite": {
        "name": "Malachite (Neon Highlight)",
        "hex": "#16db65",
        "rgb": [22, 219, 101],
        "hsl": [144, 82, 47],
        "usage": "Vibrant badges, dark footer highlights, active glows"
      }
    },
    "semantic": {
      "bgBase": "#f4fbf6",
      "bgSurface": "#ffffff",
      "bgElevated": "#edf7f1",
      "textPrimary": "#0f172a",
      "textHeading": "#0d2818",
      "textSecondary": "#334155",
      "textMuted": "#64748b",
      "borderSubtle": "#e2e8f0",
      "borderDefault": "#dcfce7",
      "borderStrong": "#058c42",
      "success": "#059669",
      "warning": "#d97706",
      "danger": "#dc2626"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "Montserrat",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'Fira Code', ui-monospace, Consolas, monospace",
      "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400&display=swap"
    },
    "fontWeights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semiBold": 600,
      "bold": 700,
      "extraBold": 800
    },
    "fontSizes": {
      "xs": {
        "rem": "0.75rem",
        "px": "12px"
      },
      "sm": {
        "rem": "0.875rem",
        "px": "14px"
      },
      "base": {
        "rem": "1rem",
        "px": "16px"
      },
      "lg": {
        "rem": "1.125rem",
        "px": "18px"
      },
      "xl": {
        "rem": "1.25rem",
        "px": "20px"
      },
      "2xl": {
        "rem": "1.5rem",
        "px": "24px"
      },
      "3xl": {
        "rem": "1.875rem",
        "px": "30px"
      },
      "4xl": {
        "rem": "2.25rem",
        "px": "36px"
      }
    }
  },
  "borderRadius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 3px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.03)",
    "md": "0 4px 12px rgba(15, 23, 42, 0.08)",
    "lg": "0 10px 25px rgba(15, 23, 42, 0.12)",
    "glow": "0 0 20px rgba(5, 140, 66, 0.18)"
  }
}
